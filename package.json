    "@react-three/rapier": "^2.2.0",
    "ecctrl": "^2.0.2",
    "hono": "^4.13.19",
    "leva": "^0.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
