{
  "name": "project-quest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "api:download": "curl -sSfL -o docs/github-api/schema.docs.graphql https://docs.github.com/public/fpt/schema.docs.graphql && curl -sSfL -o docs/github-api/rest-api.json https://raw.githubusercontent.com/github/rest-api-description/main/descriptions/api.github.com/api.github.com.json",
    "api:inventory": "tsx scripts/api-inventory.ts",
    "api:coverage": "tsx scripts/api-coverage-report.ts",
    "db:up": "docker compose up -d db",
    "db:migrate": "drizzle-kit migrate",
    "test:db": "DATABASE_URL=${TEST_DATABASE_URL:-postgres://quest:quest@localhost:5442/quest_test} vitest run src/server/db",
    "dev:demo": "QUEST_MODE=demo vite",
    "dev:live": "QUEST_MODE=live vite",
    "check": "tsc -b && oxlint && vitest run",
    "assets": "bash scripts/build-assets.sh",
    "test:e2e": "playwright test",
    "db:test:setup": "docker compose exec -T db psql -U quest -d quest -tc \"SELECT 1 FROM pg_database WHERE datname = 'quest_test'\" | grep -q 1 || docker compose exec -T db createdb -U quest quest_test; DATABASE_URL=postgres://quest:quest@localhost:5442/quest_test drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@hono/zod-validator": "^0.9.1",
    "@octokit/graphql": "^9.0.5",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@react-three/rapier": "^2.2.0",
    "drizzle-orm": "^0.45.4",
    "ecctrl": "^2.0.2",
    "hono": "^4.13.19",
    "i18next": "^27.1.3",
    "i18next-browser-languagedetector": "^8.3.0",
    "leva": "^0.10.1",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "graphql": "^17.1.0",
    "lefthook": "^2.2.2",
    "meshoptimizer": "^1.3.0",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
